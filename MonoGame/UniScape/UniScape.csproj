<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>

  <!-- The PNGs stay where they are in UniScape_assets/png and UniScape_assets/fx (no copy in the repo).
       At build time they are copied next to the .exe, into one "Assets" folder. -->
  <ItemGroup>
    <None Include="..\..\UniScape_assets\png\*.png" LinkBase="Assets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\UniScape_assets\fx\*.png" LinkBase="Assets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
